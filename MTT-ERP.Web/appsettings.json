{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiBaseUrl": "http://127.0.0.1:5050/",
  "ReverseProxy": {
    "Routes": {
      "scalar-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/scalar/{**catch-all}"
        }
      },
      "openapi-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/openapi/{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://127.0.0.1:5050/"
          }
        }
      }
    }
  }
}