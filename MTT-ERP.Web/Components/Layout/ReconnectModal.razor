<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="reconnect-card">
        <div class="ripple-loader" aria-hidden="true">
            <span></span>
            <span></span>
            <div class="ripple-core"></div>
        </div>

        <h3 class="reconnect-title components-reconnect-first-attempt-visible">
            Reconnecting to MTT ERP
        </h3>
        <h3 class="reconnect-title components-reconnect-repeated-attempt-visible">
            Auto-Retrying Connection
        </h3>
        <h3 class="reconnect-title components-reconnect-failed-visible">
            Connection Lost
        </h3>
        <h3 class="reconnect-title components-reconnect-paused-visible">
            Session Paused
        </h3>
        <h3 class="reconnect-title components-reconnect-resume-failed-visible">
            Unable to Resume
        </h3>

        <p class="reconnect-desc components-reconnect-first-attempt-visible">
            Your workspace is safe. Restoring live server sync automatically...
        </p>
        @* <p class="reconnect-desc components-reconnect-repeated-attempt-visible">
            Rejoin failed. Automatically retrying<span class="retry-countdown"> in
            <strong id="components-reconnect-seconds-to-next-retry"></strong>s</span>...
        </p> *@
        <p class="reconnect-desc components-reconnect-failed-visible">
            Could not reach the server. Please retry or reload your session.
        </p>
        <p class="reconnect-desc components-reconnect-paused-visible">
            The server paused this session due to inactivity.
        </p>
        <p class="reconnect-desc components-reconnect-resume-failed-visible">
            We couldn't restore the paused session. Please reload to continue.
        </p>

        <div class="reconnect-actions">
            <button id="components-reconnect-button" class="btn-primary components-reconnect-failed-visible">
                Retry Now
            </button>
            <button id="components-resume-button" class="btn-primary components-reconnect-paused-visible">
                Resume Session
            </button>
            <button type="button"
                    class="btn-secondary components-reconnect-failed-visible components-reconnect-resume-failed-visible"
                    onclick="location.reload()">
                Reload Page
            </button>
        </div>
    </div>
</dialog>